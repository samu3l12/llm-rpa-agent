<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RpaAgentApp.ViewModels"
             x:Class="RpaAgentApp.Views.ProceduresPage"
             Title="Procedimientos">

    <ContentPage.BindingContext>
        <vm:ProceduresViewModel />
    </ContentPage.BindingContext>

    <Grid RowDefinitions="Auto,*" BackgroundColor="#0f1117" Padding="0">

        <!-- Header -->
        <Border Grid.Row="0" BackgroundColor="#1a1d27" Padding="16" StrokeThickness="0">
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="📋 Procedimientos" FontSize="20" FontAttributes="Bold" TextColor="#a29bfe" />
                    <Label Text="{Binding StatusText}" FontSize="12" TextColor="#8b8fa3" />
                </VerticalStackLayout>
                
                <Button Grid.Column="1" Text="🔄 Actualizar" 
                        Command="{Binding RefreshCommand}" 
                        BackgroundColor="#2d3748" TextColor="White" 
                        Padding="12,8" CornerRadius="8" FontSize="14" FontAttributes="Bold"
                        VerticalOptions="Center"/>
            </Grid>
        </Border>

        <!-- Lista de procedimientos -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Procedures}" Margin="8">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1a1d27" Padding="16" Margin="4"
                            StrokeShape="RoundRectangle 12" Stroke="#2e3344" StrokeThickness="1">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Titulo}" FontSize="16"
                                   FontAttributes="Bold" TextColor="#e4e6ed" />
                            <Label Text="{Binding Id}" FontSize="11"
                                   TextColor="#6c5ce7" FontFamily="Consolas" />
                            <Label Text="{Binding Descripcion}" FontSize="13"
                                   TextColor="#8b8fa3" LineBreakMode="WordWrap" />
                            <Label FontSize="12" TextColor="#00b894">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Parámetros: " FontAttributes="Bold" />
                                        <Span Text="{Binding Parametros, StringFormat='{0}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Padding="40">
                    <Label Text="Sin procedimientos" FontSize="18" TextColor="#8b8fa3"
                           HorizontalOptions="Center" />
                    <Label Text="Asegúrate de que la API esté corriendo y haya workflows indexados"
                           FontSize="13" TextColor="#8b8fa3" HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
